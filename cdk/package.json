{
  "name": "cdk",
  "version": "1.0.0",
  "bin": {
    "cdk": "bin/cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk:deploy": "npm run clean && npm run build && cdk deploy --all",
    "cdk:deploy:ci": "npm run clean && npm run build && cdk deploy --all --require-approval never",
    "cdk:destroy": "cdk destroy --all",
    "cdk:diff": "cdk diff",
    "cdk:synth": "cdk synth --quiet",
    "check": "npm run lint:ci && npm run format:ci",
    "clean": "rm -rf dist",
    "fix": "npm run lint && npm run format",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint . --ext .ts --fix",
    "lint:ci": "eslint . --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "aws-cdk": "^2.1144.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "^10.8.1",
    "zod": "^4.6.5"
  }
}
